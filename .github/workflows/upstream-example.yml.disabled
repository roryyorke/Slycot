name: Conda build fail MWE

on:
  push:
  pull_request:

jobs:
  conda-build-mwe:
    name: Run conda build --help
    runs-on: "windows-latest"
    steps:
      - name: Setup Conda
        uses: conda-incubator/setup-miniconda@v4
        with:
          auto-update-conda: true
          miniconda-version: "latest"
          activate-environment: build-env
          conda-build-version: "26.9.1"
      - name: Bash
        shell: bash -el {0}
        run: |
          conda build --help
